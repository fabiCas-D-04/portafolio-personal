# Copia este archivo como ".env" y ajusta los valores (NO lo subas al repo)

# Usuario de DockerHub (las imágenes serán <usuario>/portfolio-backend y <usuario>/portfolio-frontend)
DOCKERHUB_USERNAME=tu-usuario-dockerhub

# Credenciales de AWS para Terraform (IAM con permisos EC2/VPC)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# Cloudflare (opcional - 30 pts extra)
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_ZONE_ID=...
CLOUDFLARE_DOMAIN=portafolio.tudominio.com
